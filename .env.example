# Anthropic Claude API anahtarı (zorunlu) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Kullanılacak Claude modeli
NEO_MODEL=claude-sonnet-5

# Hava durumu gibi konum bazlı sorular için varsayılan şehir (Phase 4)
NEO_DEFAULT_CITY=Bursa

# Sesli komut tanıma (faster-whisper) model boyutu: tiny, base, small, medium, large-v3
# Büyük modeller daha doğru ama daha yavaş/ağır; ilk kullanımda Hugging Face'ten indirilir.
# "small" (~500MB) kullanılıyor ve bu makinede kurulu; "base" (~150MB) de indirilmiş
# durumda, bağlantı sorunu yaşarsan ona düşebilirsin (doğruluk belirgin şekilde düşer).
NEO_WHISPER_MODEL=small

# cpu veya cuda (bu bilgisayarda NVIDIA GTX 1650 var, istersen cuda deneyebilirsin)
NEO_WHISPER_DEVICE=cpu

# Uyandırma: eğitilmiş bir sinir ağı modeli (openWakeWord) ile algılanır,
# öğretim/kayıt gerekmez. Sadece İngilizce hazır modeller var (alexa,
# hey_mycroft, hey_jarvis, hey_rhasspy, timer, weather) -- "Neo" yok. Model
# dosyaları ilk çalıştırmada indirilir, sonrasında tamamen çevrimdışı çalışır.
# NEO_WAKE_PHRASE sadece ekranda gösterilen metin; algılamayı NEO_WAKE_WORD_MODEL
# belirler, ikisini birlikte değiştir.
NEO_WAKE_PHRASE=Hey Jarvis
NEO_WAKE_WORD_MODEL=hey_jarvis

# Modelin ne kadar emin olması gerektiği (0..1). Bu projenin kendi test
# seslerinde gerçek "Hey Jarvis" 0.999, alakasız konuşma 0.000 skorladı --
# 0.5 varsayılanının her iki yanında da geniş bir pay var.
NEO_WAKE_WORD_THRESHOLD=0.5

# Çift alkışla da uyandırma. Öğretim gerektirmez, her dilde çalışır.
NEO_ENABLE_CLAP_WAKE=true

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
NEO_LOG_LEVEL=INFO

# Konuşma geçmişinin yazılacağı klasör. Boş bırakılırsa OneDrive varsa
# %OneDrive%\NEO kullanılır (telefondan/başka cihazdan da erişebilmek için),
# yoksa proje içindeki data/conversations klasörüne düşer.
NEO_CONVERSATION_DIR=

# Otomatik güncelleme için sürüm bilgisi adresi (https zorunlu).
# Örn. GitHub Releases'te yayınlanan latest.json:
# {"version": "0.2.0", "url": "https://.../NEO-0.2.0.zip", "sha256": "...", "notes": "..."}
# Boş bırakılırsa güncelleme kontrolü yapılmaz.
NEO_UPDATE_MANIFEST_URL=

# Faz 2: yerel LLM (Ollama + Qwen2.5:3b) - açıkken sıradan sohbet Claude'a
# hiç gitmeden yerelde/ücretsiz cevaplanır; dosya/takvim/e-posta gibi
# gerçek bir araç gerektiren istekler otomatik Claude'a yükseltilir.
# Gerekli: `ollama pull qwen2.5:3b` (bkz. README).
NEO_ENABLE_LOCAL_LLM_FALLBACK=false
NEO_ROUTE_CHAT_TO_LOCAL=false
NEO_OLLAMA_URL=http://localhost:11434
NEO_OLLAMA_MODEL=qwen2.5:3b
